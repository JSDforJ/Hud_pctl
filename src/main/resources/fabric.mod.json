{
  "schemaVersion": 1,
  "id": "hud_pctl",
  "version": "${version}",
  "name": "SpotiHUD Playerctl",
  "description": "Playerctl variables for Hudder: No setup required! Works with Spotify, YT, browsers, and more.",
  "authors": [
    "JSDfJ"
  ],
  "contact": {
    "sources": "https://github.com/JSDforJ/Hud_pctl",
    "issues": "https://github.com/JSDforJ/Hud_pctl/issues",
    "homepage": "https://github.com/JSDforJ/Hud_pctl/wiki",
    "email": "me@jaysi.cc"
  },
  "license": "LGPL-3.0",
  "icon": "assets/hud_pctl/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dk.jsdfj.hud_pctl.client.Hud_pctlClient"
    ],
    "main": [
      "dk.jsdfj.hud_pctl.Hud_pctl"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.buymeacoffee": "https://buymeacoffee.com/jsdfj",
        "modmenu.modrinth": "https://modrinth.com/mod/spotihud-playerctl",
        "modmenu.github_releases": "https://github.com/JSDforJ/Hud_pctl/releases",
        "modmenu.wiki": "https://github.com/JSDforJ/Hud_pctl/wiki"
      },
      "update_checker": true
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "hudder": ">=${hudder_version}"
  },
  "recommends": {
    "yet_another_config_lib_v3": ">=${yacl_version}"
  }
}
